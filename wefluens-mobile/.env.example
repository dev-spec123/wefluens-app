# Wefluens Connect — Supabase credentials (same project as the iOS Swift app).
# Copy this file to ".env.local" (gitignored) and fill in the real values from
# Supabase → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
